{
  "opencollection": "1.0.0",
  "info": {
    "name": "Charles Schwab Market Data API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.schwabapi.com/v1/oauth/authorize",
      "accessTokenUrl": "https://api.schwabapi.com/v1/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Quotes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get quotes for one or more symbols",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.schwabapi.com/marketdata/v1/quotes",
            "params": [
              {
                "name": "symbols",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of ticker symbols."
              },
              {
                "name": "fields",
                "value": "",
                "type": "query"
              },
              {
                "name": "indicative",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get quotes for one or more symbols"
        },
        {
          "info": {
            "name": "Get quote for a specific symbol",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.schwabapi.com/marketdata/v1/:symbol_id/quotes",
            "params": [
              {
                "name": "symbol_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get quote for a specific symbol"
        }
      ]
    },
    {
      "info": {
        "name": "Options",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get option chain for a symbol",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.schwabapi.com/marketdata/v1/chains",
            "params": [
              {
                "name": "symbol",
                "value": "",
                "type": "query"
              },
              {
                "name": "contractType",
                "value": "",
                "type": "query"
              },
              {
                "name": "strikeCount",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeQuotes",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get option chain for a symbol"
        },
        {
          "info": {
            "name": "Get option expiration chain for a symbol",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.schwabapi.com/marketdata/v1/expirationchain",
            "params": [
              {
                "name": "symbol",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get option expiration chain for a symbol"
        }
      ]
    },
    {
      "info": {
        "name": "Price History",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get price history candles for a symbol",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.schwabapi.com/marketdata/v1/pricehistory",
            "params": [
              {
                "name": "symbol",
                "value": "",
                "type": "query"
              },
              {
                "name": "periodType",
                "value": "",
                "type": "query"
              },
              {
                "name": "period",
                "value": "",
                "type": "query"
              },
              {
                "name": "frequencyType",
                "value": "",
                "type": "query"
              },
              {
                "name": "frequency",
                "value": "",
                "type": "query"
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get price history candles for a symbol"
        }
      ]
    },
    {
      "info": {
        "name": "Movers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get top movers for an index",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.schwabapi.com/marketdata/v1/movers/:symbol_id",
            "params": [
              {
                "name": "symbol_id",
                "value": "",
                "type": "path",
                "description": "Index symbol such as $DJI, $COMPX, or $SPX."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "frequency",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get top movers for an index"
        }
      ]
    },
    {
      "info": {
        "name": "Market Hours",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get market hours for one or more markets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.schwabapi.com/marketdata/v1/markets",
            "params": [
              {
                "name": "markets",
                "value": "",
                "type": "query"
              },
              {
                "name": "date",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get market hours for one or more markets"
        },
        {
          "info": {
            "name": "Get market hours for a single market",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.schwabapi.com/marketdata/v1/markets/:market_id",
            "params": [
              {
                "name": "market_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "date",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get market hours for a single market"
        }
      ]
    },
    {
      "info": {
        "name": "Instruments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search instruments by symbol or CUSIP",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.schwabapi.com/marketdata/v1/instruments",
            "params": [
              {
                "name": "symbol",
                "value": "",
                "type": "query"
              },
              {
                "name": "projection",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search instruments by symbol or CUSIP"
        }
      ]
    }
  ],
  "bundled": true
}