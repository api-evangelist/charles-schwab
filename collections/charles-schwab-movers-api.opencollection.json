{
  "opencollection": "1.0.0",
  "info": {
    "name": "Charles Schwab Market Data Accounts Movers API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.schwabapi.com/v1/oauth/authorize",
      "accessTokenUrl": "https://api.schwabapi.com/v1/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Movers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get top movers for an index",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.schwabapi.com/marketdata/v1/movers/:symbol_id",
            "params": [
              {
                "name": "symbol_id",
                "value": "",
                "type": "path",
                "description": "Index symbol such as $DJI, $COMPX, or $SPX."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "frequency",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get top movers for an index"
        }
      ]
    }
  ],
  "bundled": true
}